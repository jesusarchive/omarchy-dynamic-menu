#!/bin/bash

# Lists every executable on $PATH, like dmenu's dmenu_path. The list is cached
# and only rebuilt when a $PATH directory has changed since the last run.
# Stock dmenu uses its own `stest` for this; find does the same job here.

cachedir="${XDG_CACHE_HOME:-$HOME/.cache}"
cache="$cachedir/dmenu_run"
mkdir -p "$cachedir"

IFS=:
# stest -dqr -n "$cache" $PATH: a readable PATH directory newer than the cache.
# With no cache there is nothing to compare against, so every directory counts.
stale=false
for dir in $PATH; do
  if [[ -d $dir && -r $dir && ( ! -e $cache || $dir -nt $cache ) ]]; then
    stale=true
    break
  fi
done

if $stale; then
  # The list is built in a temp file and moved into place. Writing the cache
  # directly means an interrupted run leaves a truncated file behind, and
  # since no PATH directory is newer than it any more, later runs would reuse
  # the truncated cache instead of rebuilding it.
  tmp=$(mktemp "$cachedir/.dmenu_run.XXXXXXXXXXXX") || exit 1
  trap 'rm -f "$tmp"' EXIT

  # stest -flx $PATH: regular files (links followed) you can execute, hidden
  # names skipped.
  for dir in $PATH; do
    [[ -d $dir ]] && find -L "$dir" -mindepth 1 -maxdepth 1 ! -name '.*' -type f -executable -printf '%f\n' 2>/dev/null
  done | sort -u > "$tmp"

  mv -fT -- "$tmp" "$cache" || exit 1
fi

cat "$cache"
