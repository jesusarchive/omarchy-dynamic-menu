#!/bin/bash

# keybind add|remove: Super+D runs dmenu_run.
# Run by Service.qml. The binding is made at runtime with `hyprctl eval`, so
# nothing is written to ~/.config/hypr. A Super+D you bound yourself is left
# alone.

set -euo pipefail

action="${1-}"
bin="$(dirname "$(readlink -f "$0")")"
description="Dynamic menu"
plugin_id="jesusarchive.dynamic-menu"

# free: nothing on Super+D. ours: our binding. taken: someone else's.
state=$(hyprctl binds -j | jq -r --arg d "$description" '
  [.[] | select(.modmask == 64 and (.key | ascii_upcase) == "D")]
  | if length == 0 then "free" elif any(.description == $d) then "ours" else "taken" end')

case "$action" in
  add)
    if [[ $state == free ]]; then
      hyprctl eval "hl.bind(\"SUPER + D\", hl.dsp.exec_cmd([[bash '$bin/dmenu_run']]), { description = \"$description\" })" >/dev/null
    elif [[ $state == taken ]]; then
      echo "$plugin_id: Super+D is already bound, leaving it" >&2
    fi
    ;;
  remove)
    # The service is also torn down on a plugin hot reload. Only drop the
    # binding when the plugin has really been disabled or removed.
    enabled=$(omarchy plugin list --json | jq -r --arg id "$plugin_id" 'any(.[]; .id == $id and .enabled)')
    if [[ $state == ours && $enabled != true ]]; then
      hyprctl eval 'hl.unbind("SUPER + D")' >/dev/null
    fi
    ;;
  *)
    echo "usage: keybind add|remove" >&2
    exit 1
    ;;
esac
