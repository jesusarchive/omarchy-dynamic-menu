#!/bin/bash

# dmenu for the Omarchy shell: reads items from stdin, prints the pick.
# Takes suckless dmenu's flags. Colors and font follow the live Omarchy theme,
# so they track `omarchy theme set`; -fn/-nb/-nf/-sb/-sf override them.
# -f and -w (X11 window embedding) are accepted and ignored.

set -euo pipefail

plugin_id=jesusarchive.dynamic-menu

usage() {
  echo "usage: dmenu [-bfiv] [-l lines] [-p prompt] [-fn font] [-m monitor]" >&2
  echo "             [-nb color] [-nf color] [-sb color] [-sf color] [-w windowid]" >&2
  exit 1
}

# C's atoi: leading whitespace, optional sign, digits; anything else reads as 0.
atoi() {
  if [[ $1 =~ ^[[:space:]]*([+-]?)([0-9]+) ]]; then
    echo $(( ${BASH_REMATCH[1]}10#${BASH_REMATCH[2]} ))
  else
    echo 0
  fi
}

prompt=""
font=""
norm_bg=""
norm_fg=""
sel_bg=""
sel_fg=""
lines=0
monitor=-1
bottom=false
case_insensitive=false

# Same order of checks as dmenu's main(): flags without an argument first,
# then a flag in last position is an error, then flags with one argument.
while (( $# > 0 )); do
  case "$1" in
    -v)
      bin="$(dirname "$(readlink -f "$0")")"
      echo "dmenu-$(jq -r .version "$bin/../manifest.json")"
      exit 0
      ;;
    -b) bottom=true ;;
    -f) ;;
    -i) case_insensitive=true ;;
    *)
      (( $# == 1 )) && usage
      case "$1" in
        -l) lines=$(atoi "$2") ;;
        -m) monitor=$(atoi "$2") ;;
        -p) prompt="$2" ;;
        -fn) font="$2" ;;
        -nb) norm_bg="$2" ;;
        -nf) norm_fg="$2" ;;
        -sb) sel_bg="$2" ;;
        -sf) sel_fg="$2" ;;
        -w) ;;
        *) usage ;;
      esac
      shift
      ;;
  esac
  shift
done

items_file=$(mktemp)
selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"

# The menu surface takes the keyboard exclusively, so a caller killed while it
# is open would leave it on screen with the grab held. The done file exists
# only once the menu has closed itself, so its absence means we still owe a
# hide.
cleanup() {
  [[ -e $done_file ]] || omarchy-shell shell hide "$plugin_id" >/dev/null 2>&1 || true
  rm -f "$items_file" "$selection_file" "$done_file" "$done_file.tmp"
}
trap cleanup EXIT
trap 'exit 1' INT TERM

# Items go to the plugin as a file, like dmenu reading stdin itself. Putting
# them in the IPC argument would hit Linux's 128 KB limit on one argument.
cat > "$items_file"

shell_json="$HOME/.config/omarchy/shell.json"
bar_position=$(jq -r '.bar.position // "top"' "$shell_json" 2>/dev/null || echo top)

payload=$(jq -n \
  --arg barPosition "$bar_position" \
  --arg prompt "$prompt" \
  --arg font "$font" \
  --arg normBg "$norm_bg" \
  --arg normFg "$norm_fg" \
  --arg selBg "$sel_bg" \
  --arg selFg "$sel_fg" \
  --argjson lines "$lines" \
  --argjson monitor "$monitor" \
  --argjson bottom "$bottom" \
  --argjson caseInsensitive "$case_insensitive" \
  --arg itemsFile "$items_file" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  '{ barPosition: $barPosition, prompt: $prompt, font: $font, normBg: $normBg, normFg: $normFg,
     selBg: $selBg, selFg: $selFg, lines: $lines, monitor: $monitor,
     bottom: $bottom, caseInsensitive: $caseInsensitive, itemsFile: $itemsFile,
     selectionFile: $selectionFile, doneFile: $doneFile }')

# omarchy-shell gives up after 2 s by default. The first summon after the
# plugin is (re)loaded can take longer than that.
#
# The IPC exits 0 whether or not it summoned anything. The answer is on
# stdout, "ok" or "unknown". Checking the status alone never catches a
# disabled or missing plugin, and the wait below would then never end.
summoned=$(OMARCHY_SHELL_IPC_TIMEOUT=10s omarchy-shell shell summon "$plugin_id" "$payload" 2>/dev/null) || true
if [[ $summoned != ok ]]; then
  echo "dmenu: the Omarchy shell did not open the menu (${summoned:-no response})" >&2
  exit 1
fi

# The menu appends every printed line to the selection file (Ctrl+Return
# prints and stays open), then writes the exit status to the done file.
# Pass lines on as they come, like dmenu writing to stdout.
printed=0
flush() {
  local size
  size=$(stat -c %s "$selection_file")
  if (( size > printed )); then
    tail -c +$(( printed + 1 )) "$selection_file" | head -c $(( size - printed ))
    printed=$size
  fi
}

# `omarchy restart shell` drops the plugin without writing a done file, so
# check every two seconds that the shell is still answering rather than
# waiting for a file that will never arrive.
ticks=0
while [[ ! -e $done_file ]]; do
  flush
  sleep 0.05
  if (( ++ticks % 40 == 0 )) && ! omarchy-shell shell ping >/dev/null 2>&1; then
    echo "dmenu: the Omarchy shell went away" >&2
    exit 1
  fi
done
flush

status=$(<"$done_file")
[[ $status == 0 ]] && exit 0
exit 1
