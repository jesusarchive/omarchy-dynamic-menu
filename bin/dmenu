#!/bin/bash

# dmenu for the Omarchy shell: reads items from stdin, prints the pick.
# Takes suckless dmenu's flags. Fonts, colors and window embedding are accepted
# and ignored: the Omarchy theme styles the menu.

set -euo pipefail

usage() {
  echo "usage: dmenu [-bfiv] [-l lines] [-p prompt] [-fn font] [-m monitor]" >&2
  echo "             [-nb color] [-nf color] [-sb color] [-sf color] [-w windowid]" >&2
  exit 1
}

# C's atoi: leading whitespace, optional sign, digits; anything else reads as 0.
atoi() {
  if [[ $1 =~ ^[[:space:]]*([+-]?)([0-9]+) ]]; then
    echo $(( ${BASH_REMATCH[1]}10#${BASH_REMATCH[2]} ))
  else
    echo 0
  fi
}

prompt=""
lines=0
monitor=-1
bottom=false
case_insensitive=false

# Same order of checks as dmenu's main(): flags without an argument first,
# then a flag in last position is an error, then flags with one argument.
while (( $# > 0 )); do
  case "$1" in
    -v)
      bin="$(dirname "$(readlink -f "$0")")"
      echo "dmenu-$(jq -r .version "$bin/../manifest.json")"
      exit 0
      ;;
    -b) bottom=true ;;
    -f) ;;
    -i) case_insensitive=true ;;
    *)
      (( $# == 1 )) && usage
      case "$1" in
        -l) lines=$(atoi "$2") ;;
        -m) monitor=$(atoi "$2") ;;
        -p) prompt="$2" ;;
        -fn | -nb | -nf | -sb | -sf | -w) ;;
        *) usage ;;
      esac
      shift
      ;;
  esac
  shift
done

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

payload=$(jq -Rn \
  --arg prompt "$prompt" \
  --argjson lines "$lines" \
  --argjson monitor "$monitor" \
  --argjson bottom "$bottom" \
  --argjson caseInsensitive "$case_insensitive" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  '{ prompt: $prompt, lines: $lines, monitor: $monitor, bottom: $bottom,
     caseInsensitive: $caseInsensitive, items: [inputs],
     selectionFile: $selectionFile, doneFile: $doneFile }')

omarchy-shell shell summon jesusarchive.dynamic-menu "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
