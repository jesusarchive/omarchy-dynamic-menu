#!/bin/bash

# Pick a program from $PATH and run it, like dmenu's dmenu_run.
# It calls the other scripts by path through bash, so the keybinding does not
# depend on Hyprland's $PATH or executable file modes.

bin="$(dirname "$(readlink -f "$0")")"

bash "$bin/dmenu_path" | bash "$bin/dmenu" "$@" | "${SHELL:-/bin/sh}" &
